# Supabase Edge Function Secrets for nutrifridge-ai
# Set these in Supabase Dashboard -> Edge Functions -> nutrifridge-ai -> Secrets
# Or via CLI: supabase secrets set --env-file ./supabase/functions/nutrifridge-ai/.env

# The URL of your active n8n webhook (POST)
# Downstream n8n workflow routes requests to Gemini 3.8 Flash:
# https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/nutrifridge/ai

# Shared server-to-server secret verified by n8n
N8N_WEBHOOK_SECRET=your_secure_server_side_webhook_secret_here
